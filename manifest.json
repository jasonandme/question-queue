{
  "manifest_version": 3,
  "name": "追问簿 · Question Queue",
  "version": "0.6.0",
  "description": "在大模型对话与知识学习网页中随手记录疑问，保留文章上下文，并在下一轮对话中批量追问。",
  "permissions": ["storage", "contextMenus", "activeTab", "sidePanel"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*",
    "https://poe.com/*",
    "https://copilot.microsoft.com/*",
    "https://www.doubao.com/*",
    "https://yuanbao.tencent.com/*",
    "https://*.csdn.net/*",
    "https://*.zhihu.com/*",
    "https://*.maas.aliyuncs.com/*",
    "https://dashscope.aliyuncs.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "打开追问簿",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-question-queue": {
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac": "Alt+Shift+Q"
      },
      "description": "打开追问簿"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://poe.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.doubao.com/*",
        "https://yuanbao.tencent.com/*",
        "https://*.csdn.net/*",
        "https://*.zhihu.com/*"
      ],
      "js": ["site-adapters.js", "question-store.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
